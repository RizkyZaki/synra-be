generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUPERVISOR
  OPERATOR
  MANAGEMENT
  AUDITOR
}

enum MetricType {
  CPU
  MEMORY
  DISK
  UPTIME
  LOG_ERROR_COUNT
}

enum Severity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Alur: NEW -> ACKNOWLEDGED -> IN_PROGRESS -> PENDING_REVIEW -> CLOSED
/// (PENDING_REVIEW dapat dikembalikan ke IN_PROGRESS)
enum AlertStatus {
  NEW
  ACKNOWLEDGED
  IN_PROGRESS
  PENDING_REVIEW
  CLOSED
}

enum AlertAction {
  CREATED
  ACKNOWLEDGED
  STARTED
  SUBMITTED_REVIEW
  RETURNED
  CLOSED
  SEVERITY_RAISED
  ESCALATED
}

enum ThresholdOperator {
  GT
  GTE
}

enum RuleMetric {
  CPU
  MEMORY
  DISK
  HOST_STALE
  /// Jumlah kegagalan beruntun satu job backup
  BACKUP_FAILED
  /// Jam sejak backup terakhir yang berhasil untuk satu job
  BACKUP_AGE
}

enum IngestSource {
  ELASTICSEARCH
  CSV
}

enum NotifStatus {
  SENT
  FAILED
  SKIPPED
}

enum AssetCategory {
  HARDWARE
  SOFTWARE
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  ACCOUNT_LOCKED
  PASSWORD_CHANGE
  THRESHOLD_CREATE
  THRESHOLD_UPDATE
  THRESHOLD_DELETE
  ALERT_STATUS_CHANGE
  ALERT_EVALUATE
  ASSET_CREATE
  ASSET_UPDATE
  ASSET_DELETE
  HOST_CREATE
  HOST_UPDATE
  HOST_DELETE
  REPORT_EXPORT
  METRIC_IMPORT
  USER_CREATE
  USER_UPDATE
  USER_UNLOCK
  USER_RESET_PASSWORD
  LIFECYCLE_CREATE
  LIFECYCLE_UPDATE
  LIFECYCLE_DELETE
  RENEWAL_REQUEST
  RENEWAL_DECIDE
  ESCALATION_UPDATE
  ALERT_ATTACHMENT_UPLOAD
}

enum BackupStatus {
  SUCCESS
  FAILED
}

model User {
  id               String    @id @default(uuid())
  username         String    @unique
  passwordHash     String
  fullName         String
  role             Role
  isActive         Boolean   @default(true)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Host {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  region    String?
  assets    Asset[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Asset {
  id                 String         @id @default(uuid())
  /// Dicocokkan dengan host.name dari Metricbeat/Filebeat
  hostname           String         @unique
  ipAddress          String
  /// Mis. CORE_BANKING, DATABASE, WEB, MIDDLEWARE
  component          String
  hostId             String
  host               Host           @relation(fields: [hostId], references: [id])
  /// Null untuk aset lama yang belum diklasifikasikan; wajib diisi saat aset baru dibuat
  category           AssetCategory?
  /// Mis. CPU untuk HARDWARE, VM untuk SOFTWARE
  type               String?
  picName            String
  picContact         String?
  notes              String?
  isActive           Boolean        @default(true)
  lastSeenAt         DateTime?
  isStale            Boolean        @default(false)
  metrics            Metric[]
  alerts             Alert[]
  backupRuns         BackupRun[]
  /// id pelaku disimpan tanpa FK, seperti actorId pada AlertEvent dan AuditLog
  userInputId        String?
  dtimeInput         DateTime       @default(now())
  userUpdateId       String?
  /// Waktu edit oleh user; updatedAt juga berubah saat ingest dan evaluasi otomatis
  timeUpdate         DateTime?
  supervisorInputId  String?
  supervisorUpdateId String?
  updatedAt          DateTime       @updatedAt

  @@index([hostId, component])
}

model Metric {
  id        BigInt       @id @default(autoincrement())
  assetId   String
  asset     Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  metric    MetricType
  /// Mount point untuk DISK, string kosong untuk metrik lain
  label     String       @default("")
  /// Persen 0-100; UPTIME dalam milidetik; LOG_ERROR_COUNT berupa jumlah
  value     Float
  timestamp DateTime
  source    IngestSource

  @@unique([assetId, metric, label, timestamp])
  @@index([assetId, metric, timestamp])
}

/// Cursor ingest per index pattern (mis. "metricbeat-*")
model IngestionState {
  id            String   @id
  lastTimestamp DateTime
  updatedAt     DateTime @updatedAt
}

model IngestionRun {
  id           String       @id @default(uuid())
  source       IngestSource
  startedAt    DateTime     @default(now())
  finishedAt   DateTime?
  docsRead     Int          @default(0)
  metricsSaved Int          @default(0)
  unknownHosts String[]
  error        String?
}

model ThresholdRule {
  id             String            @id @default(uuid())
  metric         RuleMetric
  severity       Severity
  operator       ThresholdOperator @default(GT)
  /// Persen untuk CPU/MEMORY/DISK; menit untuk HOST_STALE
  value          Float
  enabled        Boolean           @default(true)
  recommendation String?
  updatedById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([metric, severity])
}

model Alert {
  id               String            @id @default(uuid())
  /// Nomor urut untuk tampilan, mis. ALT-012
  number           Int               @unique @default(autoincrement())
  assetId          String
  asset            Asset             @relation(fields: [assetId], references: [id])
  metric           RuleMetric
  label            String            @default("")
  severity         Severity
  status           AlertStatus       @default(NEW)
  /// "<assetId>:<metric>:<label>" selama alert belum CLOSED, NULL setelah CLOSED.
  /// Unique constraint menjamin deduplikasi di level database.
  dedupKey         String?           @unique
  problem          String
  value            Float
  lastValue        Float
  thresholdValue   Float
  picName          String
  recommendation   String
  detectedAt       DateTime          @default(now())
  lastEvaluatedAt  DateTime          @default(now())
  /// false bila evaluasi terakhir tidak lagi menemukan kondisi ini (sudah pulih, tetapi belum ditutup manusia)
  conditionActive  Boolean           @default(true)
  recoveredAt      DateTime?
  acknowledgedAt   DateTime?
  acknowledgedById String?
  closedAt         DateTime?
  closedById       String?
  closeNote        String?
  /// Tingkat eskalasi terakhir yang sudah dikirim (0 = belum dieskalasi)
  escalationLevel  Int               @default(0)
  lastEscalatedAt  DateTime?
  events           AlertEvent[]
  notifications    NotificationLog[]
  attachments      AlertAttachment[]

  @@index([status, severity])
  @@index([assetId, metric, label, status])
}

/// Riwayat penanganan alert (timeline)
model AlertEvent {
  id            String       @id @default(uuid())
  alertId       String
  alert         Alert        @relation(fields: [alertId], references: [id], onDelete: Cascade)
  action        AlertAction
  fromStatus    AlertStatus?
  toStatus      AlertStatus
  note          String?
  evidence      String?
  actorId       String?
  /// "system" untuk aksi otomatis (pembuatan alert oleh evaluator)
  actorUsername String
  createdAt     DateTime     @default(now())

  @@index([alertId, createdAt])
}

model NotificationLog {
  id        String      @id @default(uuid())
  /// NULL untuk pesan uji
  alertId   String?
  alert     Alert?      @relation(fields: [alertId], references: [id])
  event     AlertAction
  channel   String      @default("TELEGRAM")
  status    NotifStatus
  message   String
  error     String?
  createdAt DateTime    @default(now())

  @@index([createdAt])
}

/// Append-only. UPDATE/DELETE diblokir oleh trigger database (lihat migrasi init).
model AuditLog {
  id            BigInt      @id @default(autoincrement())
  action        AuditAction
  actorId       String?
  actorUsername String
  entity        String?
  entityId      String?
  before        Json?
  after         Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime    @default(now())

  @@index([action, createdAt])
  @@index([actorUsername, createdAt])
}

/// Kategori item siklus hidup (OS, lisensi, sertifikat, garansi, kontrak vendor)
enum LifecycleCategory {
  OS
  LICENSE
  CERTIFICATE
  WARRANTY
  CONTRACT
}

enum LifecycleStatus {
  ACTIVE
  RENEWED
  TERMINATED
  INACTIVE
}

enum RenewalStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Item yang punya tanggal berakhir: OS end-of-support, lisensi, sertifikat SSL/TLS, garansi, kontrak.
model LifecycleItem {
  id          String            @id @default(uuid())
  /// Kode unik yang dibaca manusia, mis. LIC-001
  code        String            @unique
  name        String
  category    LifecycleCategory
  status      LifecycleStatus   @default(ACTIVE)
  /// Tanggal berakhir (tanpa jam)
  expiryDate  DateTime          @db.Date
  quantity    Int               @default(1)
  allocated   Int               @default(0)
  location    String?
  picName     String?
  vendor      String?
  notes       String?
  createdById String?
  updatedById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  renewals    RenewalRequest[]

  @@index([category, expiryDate])
}

/// Pengajuan perpanjangan untuk satu item siklus hidup.
model RenewalRequest {
  id              String        @id @default(uuid())
  number          Int           @unique @default(autoincrement())
  itemId          String
  item            LifecycleItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  status          RenewalStatus @default(PENDING)
  note            String?
  requestedById   String
  requestedByName String
  decidedById     String?
  decidedByName   String?
  decisionNote    String?
  decidedAt       DateTime?
  createdAt       DateTime      @default(now())

  @@index([itemId, status])
}

/// Hasil satu eksekusi job backup, dibaca dari Filebeat (event.dataset = "synra.backup").
model BackupRun {
  id          String       @id @default(uuid())
  assetId     String
  asset       Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// Nama job, mis. "db-full" atau "config-snapshot"
  jobName     String
  /// FULL, INCREMENTAL, DIFFERENTIAL, SNAPSHOT, LOG
  type        String       @default("FULL")
  status      BackupStatus
  startedAt   DateTime?
  finishedAt  DateTime
  sizeBytes   BigInt?
  durationSec Int?
  /// Tujuan penyimpanan, mis. "nas-dc1" atau "s3://bucket"
  target      String?
  /// Pesan singkat dari skrip backup (khusus kegagalan)
  message     String?
  createdAt   DateTime     @default(now())

  @@unique([assetId, jobName, finishedAt])
  @@index([assetId, jobName, finishedAt])
  @@index([finishedAt])
}

/// Kebijakan SLA dan eskalasi per severity.
model EscalationPolicy {
  severity       Severity         @id
  /// Batas waktu alert harus diakui (menit sejak terdeteksi)
  ackMinutes     Int
  /// Batas waktu alert harus ditutup (menit sejak terdeteksi)
  resolveMinutes Int
  enabled        Boolean          @default(true)
  steps          EscalationStep[]
  updatedById    String?
  updatedAt      DateTime         @updatedAt
}

/// Satu tingkat eskalasi: bila alert belum ditutup setelah afterMinutes, kirim ke target ini.
model EscalationStep {
  id             String           @id @default(uuid())
  severity       Severity
  policy         EscalationPolicy @relation(fields: [severity], references: [severity], onDelete: Cascade)
  level          Int
  afterMinutes   Int
  /// Jabatan atau tim tujuan, mis. "Supervisor NOC"
  targetLabel    String
  /// Mention Telegram, mis. "@budi_noc" (opsional)
  mention        String?
  /// Chat Telegram tambahan untuk tingkat ini; kosong = grup utama
  telegramChatId String?

  @@unique([severity, level])
}

/// Lampiran bukti remediasi (screenshot, log, PDF). Tidak bisa dihapus agar bukti tetap utuh.
model AlertAttachment {
  id             String   @id @default(uuid())
  alertId        String
  alert          Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  fileName       String
  mimeType       String
  sizeBytes      Int
  /// Nama file di direktori UPLOAD_DIR (acak, bukan nama asli)
  storageKey     String   @unique
  /// Hash isi file untuk membuktikan file tidak berubah
  sha256         String
  uploadedById   String?
  uploadedByName String
  createdAt      DateTime @default(now())

  @@index([alertId])
}
