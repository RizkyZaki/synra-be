# ---------- Aplikasi ----------
NODE_ENV=development
PORT=3000
# Origin frontend yang diizinkan (pisahkan dengan koma)
CORS_ORIGINS=http://localhost:5173

# ---------- Database ----------
POSTGRES_USER=synra
POSTGRES_PASSWORD=ganti_password_db
POSTGRES_DB=synra
# Saat backend jalan di host, gunakan localhost. Di docker-compose, host di-override menjadi "postgres".
DATABASE_URL=postgresql://synra:ganti_password_db@localhost:5432/synra?schema=public

# ---------- Auth ----------
# Wajib minimal 32 karakter acak. Contoh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti_dengan_string_acak_minimal_32_karakter_xxxxxxxx
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Akun admin awal (dibuat oleh `npm run seed` bila belum ada)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=GantiPassword123
SEED_ADMIN_FULLNAME=Administrator SYNRA

# ---------- Elasticsearch (read-only) ----------
# Lokal: http://localhost:9200 (docker-compose). Produksi: ES kantor, hanya dari jaringan kantor.
ELASTICSEARCH_NODE=http://localhost:9200
# Isi salah satu: username/password ATAU API key (role read-only ke metricbeat-* dan filebeat-*)
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=
# Path sertifikat CA bila ES memakai TLS dengan CA internal
ELASTICSEARCH_CA_CERT_PATH=
ELASTICSEARCH_TLS_REJECT_UNAUTHORIZED=true
METRICBEAT_INDEX=metricbeat-*
FILEBEAT_INDEX=filebeat-*

# Folder lampiran bukti remediasi (di Docker: volume uploads → /app/uploads)
UPLOAD_DIR=./uploads

# ---------- Ingestion ----------
INGEST_ENABLED=true
INGEST_INTERVAL_MINUTES=5
# Pada run pertama, data diambil mundur sejauh ini
INGEST_INITIAL_LOOKBACK_HOURS=24
# Jendela tumpang-tindih untuk dokumen yang datang terlambat (aman karena insert idempoten)
INGEST_OVERLAP_SECONDS=60
INGEST_MAX_DOCS_PER_RUN=50000

# ---------- Telegram ----------
# Kosongkan untuk menonaktifkan notifikasi (tercatat sebagai SKIPPED)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Laporan ----------
REPORT_TIMEZONE=Asia/Jakarta

# ---------- Seed (development) ----------
# Bila diisi, seed membuat user contoh: supervisor, operator, manajemen, auditor dengan password ini
SEED_DEMO_PASSWORD=
# Set false untuk tidak membuat host/aset contoh (yang cocok dengan simulator)
SEED_SAMPLE_ASSETS=true
